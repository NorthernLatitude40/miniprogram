<view class="page-container">

  <!-- 自定義公共頂欄 -->
  <nav-bar title="{{ lang.sale_mgmt || '預約管理' }}"></nav-bar>

  <!-- 1. TDesign 平铺月历 -->
  <view class="calendar-card">
    <t-calendar
      use-popup="{{false}}"
      visible="{{true}}"
      value="{{selectedDate}}"
      format="{{formatDate}}"
      bind:select="onSelectDate"
      bind:panel-change="onPanelChange"
    />
  </view>

  <!-- 2. 选中日期的事件列表区域 -->
  <view class="events-panel">
    <view class="panel-header">
      <text class="title">{{selectedDateStr}} 日程/预约</text>
      <text class="count">共 {{activeDayEvents.length}} 项</text>
    </view>

    <!-- 无事件缺省页 -->
    <view wx:if="{{activeDayEvents.length === 0}}" class="empty-tip">
      当天暂无安排
    </view>

    <!-- 事件列表 -->
    <view 
      wx:for="{{activeDayEvents}}" 
      wx:key="id" 
      class="event-item type-{{item.type || 'primary'}}"
      bindtap="onEventTap"
      data-event-id="{{item.id}}"
    >
      <view class="event-time">{{item.time}}</view>
      <view class="event-title">{{item.title}}</view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>