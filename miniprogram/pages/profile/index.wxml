<view class="container">
  <!-- 1. 自定义顶部导航栏 (含返回键) -->
  <view class="custom-nav-bar" style="height: {{statusBarHeight + navBarHeight}}px;">
    <view 
      class="back-btn" 
      bindtap="goBack"
      style="top: {{menuTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      <text class="back-icon">‹</text>
    </view>
    <view 
      class="nav-title" 
      style="top: {{menuTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      个人信息
    </view>
  </view>

  <!-- 2. 信息列表卡片 -->
  <view class="info-card">
    <view class="info-item">
      <text class="label">头像</text>
      <view class="avatar-box">
        <image class="avatar-img" src="/assets/logo.png" mode="aspectFit" />
      </view>
    </view>

    <view class="divider"></view>

    <view class="info-item" bindtap="handleEditNickname">
      <text class="label">昵称</text>
      <text class="value">{{userInfo.nickname}}</text>
    </view>

    <view class="divider"></view>

    <view class="info-item">
      <text class="label">账号角色</text>
      <text class="value">{{userInfo.roleName}}</text>
    </view>

    <view class="divider"></view>

    <view class="info-item" bindtap="handleEditPhone">
      <text class="label">手机号码</text>
      <text class="value">{{userInfo.phone}}</text>
    </view>

    <view class="divider"></view>

    <view class="info-item">
      <text class="label">绑定店铺</text>
      <text class="value">{{userInfo.shopName}}</text>
    </view>
  </view>

  <!-- 3. 退出登录按钮 -->
  <view class="logout-btn" bindtap="handleLogout">
    退出登录
  </view>
</view>