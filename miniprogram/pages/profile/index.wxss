page {
  background-color: #f5f6fa;
  box-sizing: border-box;
}

.container {
  width: 100%;
  padding: 0 32rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 顶栏与返回键样式 */
.custom-nav-bar {
  position: relative;
  width: 100%;
}

.back-btn {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 30rpx;
  z-index: 100;
}

.back-icon {
  font-size: 52rpx;
  color: #333333;
  font-weight: 400;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  margin: auto;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  pointer-events: none;
}

/* 信息展示卡片 */
.info-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 32rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
  padding: 10rpx 0;
}

.label {
  font-size: 30rpx;
  color: #333333;
}

.value {
  font-size: 28rpx;
  color: #666666;
}

.avatar-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e3f2fd;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 50rpx;
  height: 50rpx;
}

.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  width: 100%;
}

/* 退出登录按钮 */
.logout-btn {
  width: 100%;
  height: 96rpx;
  background-color: #ffffff;
  color: #e53935;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.logout-btn:active {
  background-color: #fce4e4;
}