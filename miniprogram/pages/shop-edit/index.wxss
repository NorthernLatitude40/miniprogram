page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
}

.container {
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ================= 1. 自定义导航栏 ================= */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 999;
}

.back-btn {
  position: absolute;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 20rpx;
  z-index: 1000;
}

.back-icon {
  font-size: 52rpx;
  color: #333333;
  font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  margin: auto;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  pointer-events: none;
}

/* ================= 2. 页面主体（强制铺满屏幕） ================= */
.page-content {
  width: 100%; /* 重点：宽度撑满 */
  padding-left: 24rpx; /* 左右只留最适宜的边距 */
  padding-right: 24rpx;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box; /* 保证 padding 不增加总宽度 */
}

.form-card {
  width: 100%; /* 强制卡片 100% 宽度 */
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.form-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.form-card .form-row:last-child {
  border-bottom: none;
}

.logo-row {
  padding: 24rpx 0;
}

.row-label {
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0; /* 阻止标题被压缩 */
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
}

/* Logo 区域 */
.logo-wrapper {
  width: 96rpx;
  height: 96rpx;
  background-color: #e3f2fd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.css-shop-icon {
  width: 44rpx;
  height: 32rpx;
  background-color: #1976d2;
  position: relative;
  border-radius: 2rpx;
  margin-top: 10rpx;
}

.css-shop-icon::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: -4rpx;
  width: 52rpx;
  height: 12rpx;
  background-color: #1976d2;
  border-radius: 6rpx 6rpx 0 0;
}

.css-shop-icon::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 18rpx;
  background-color: #e3f2fd;
  border-radius: 4rpx 4rpx 0 0;
}

.row-input {
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  margin-left: 30rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333333;
}

.picker-value.placeholder {
  color: #cccccc;
}

/* ================= 3. 底部固定保存栏 ================= */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 99;
}

.btn-save {
  width: 100% !important;
  height: 88rpx;
  background-color: #2979ff;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}