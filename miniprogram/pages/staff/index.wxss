page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  width: 100%;
}

.container {
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  display: block !important; /* 确保不会在垂直方向居中 */
}

/* ================= 1. 自定义导航栏 ================= */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 999;
}

.back-btn {
  position: absolute;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 20rpx;
  z-index: 1000;
}

.back-icon {
  font-size: 52rpx;
  color: #333333;
  font-weight: 300;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  margin: auto;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  pointer-events: none;
}

/* ================= 2. 页面主体内容 ================= */
.page-content {
  width: 100%;
  padding-left: 24rpx;
  padding-right: 24rpx;
  /* padding-top 可在 wxml 中直接内联绑定导航栏高度，避免遮挡 */
  padding-bottom: 220rpx; 
  box-sizing: border-box;
  margin: 0 !important;
  display: block !important;
}

.staff-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 !important;
  padding: 0 !important;
}

.staff-item {
  width: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  display: flex !important;
  flex-direction: row !important;
  justify-content: space-between !important;
  align-items: center !important;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0f0f0;
}

.staff-item:active {
  background-color: #f9f9f9;
}

.staff-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.staff-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.staff-status {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
}

/* 待认领黄色高亮标签 */
.staff-status.unbound {
  color: #ff9900;
  background: #fffbe6;
}

.tag-creator {
  font-size: 22rpx;
  color: #999999;
  background-color: #f2f2f2;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.staff-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 卡片右侧的小邀请按钮样式 */
.btn-item-invite {
  margin: 0 !important;
  padding: 0 24rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 24rpx !important;
  font-weight: normal !important;
  color: #2979ff !important;
  background-color: #e8f3ff !important;
  border-radius: 28rpx !important;
}

.btn-item-invite::after {
  border: none;
}

.arrow {
  font-size: 32rpx;
  color: #cccccc;
  line-height: 1;
  margin-left: 10rpx;
}

/* ================= 3. 底部操作栏 ================= */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  background-color: #ffffff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

.btn-invite {
  flex: 1 !important;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f5f5f5 !important;
  color: #333333 !important;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx !important;
  font-weight: normal !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
}

.btn-add {
  flex: 2 !important;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #2979ff !important;
  color: #ffffff !important;
  border-radius: 12rpx;
  font-size: 28rpx !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
}