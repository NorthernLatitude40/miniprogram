<!-- pages/my/index.wxml -->
<view class="container">
  <!-- 1. 自定义导航栏区域 -->
  <view class="custom-nav-bar" style="height: {{statusBarHeight + navBarHeight}}px;">
    <!-- 返回按钮：严格与右侧胶囊对齐 -->
    <view 
      class="back-btn" 
      bindtap="goBack"
      style="top: {{menuTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      <text class="back-icon">‹</text>
    </view>

    <!-- 标题：垂直居中 -->
    <view 
      class="nav-title" 
      style="top: {{menuTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      我的
    </view>
  </view>

  <!-- 2. 顶部 Header 蓝底卡片 -->
  <view class="header-card" bindtap="goToProfile">
    <view class="avatar-box">
      <image class="avatar-icon" src="/assets/logo.png" mode="aspectFit" />
    </view>
    <view class="user-info">
      <view class="title-row">
        <text class="role-name">个人信息</text>
        <text class="arrow-right-white">›</text>
      </view>
      <view class="sub-row">
        <!-- <text class="shop-tip">演示</text>
        <text class="switch-icon">⇄</text> -->
      </view>
    </view>
  </view>

  <!-- 3. 店铺管理卡片 -->
  <view class="section-card">
    <view class="menu-row" bindtap="goToShopManagement">
      <view class="row-left">
        <text class="row-icon">🏪</text>
        <view class="row-text-group">
          <text class="row-title">店铺管理</text>
          <text class="row-desc">店铺信息 | 员工管理</text>
        </view>
      </view>
      <text class="arrow-right">›</text>
    </view>
  </view>
</view>