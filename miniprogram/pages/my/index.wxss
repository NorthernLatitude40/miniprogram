

/* 藍色 Header 卡片 */
.header-card {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #2979ff, #1565c0);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(41, 121, 255, 0.25);
  transition: opacity 0.2s ease;
}

.header-card:active {
  opacity: 0.9;
}

.avatar-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-icon {
  width: 64rpx;
  height: 64rpx;
}

.user-info {
  flex: 1;
}

.title-row {
  display: flex;
  align-items: center;
}

.role-name {
  font-size: 34rpx;
  font-weight: bold;
}

.arrow-right-white {
  font-size: 36rpx;
  margin-left: 12rpx;
  opacity: 0.8;
  line-height: 1;
}

.sub-row {
  display: flex;
  align-items: center;
  opacity: 0.9;
}

.shop-tip {
  font-size: 24rpx;
}

.switch-icon {
  font-size: 24rpx;
  margin-left: 8rpx;
}
