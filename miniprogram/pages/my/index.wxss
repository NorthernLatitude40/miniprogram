/* pages/my/index.wxss */
page {
  background-color: #f5f6fa;
  box-sizing: border-box;
}

.container {
  width: 100%;
  padding: 0 32rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 導航欄頂層容器 */
.custom-nav-bar {
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

/* 返回按鈕絕對定位在左側 */
.back-btn {
  position: absolute;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 30rpx;
  z-index: 100;
}

.back-btn:active {
  opacity: 0.6;
}

.back-icon {
  font-size: 52rpx;
  color: #333333;
  font-weight: 400;
}

/* 標題居中 */
.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  margin: auto;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  pointer-events: none; /* 防止遮擋點擊事件 */
}

/* 藍色 Header 卡片 */
.header-card {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(135deg, #2979ff, #1565c0);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(41, 121, 255, 0.25);
  transition: opacity 0.2s ease;
}

.header-card:active {
  opacity: 0.9;
}

.avatar-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-icon {
  width: 64rpx;
  height: 64rpx;
}

.user-info {
  flex: 1;
}

.title-row {
  display: flex;
  align-items: center;
}

.role-name {
  font-size: 34rpx;
  font-weight: bold;
}

.arrow-right-white {
  font-size: 36rpx;
  margin-left: 12rpx;
  opacity: 0.8;
  line-height: 1;
}

.sub-row {
  display: flex;
  align-items: center;
  opacity: 0.9;
}

.shop-tip {
  font-size: 24rpx;
}

.switch-icon {
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 通用白色圓角卡片 */
.section-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  position: relative;
  transition: background-color 0.2s ease;
}

/* 卡片內多個選單項之間的底部分割線 */
.menu-row:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  left: 60rpx;
  height: 1rpx;
  background-color: #f0f0f0;
}

.menu-row:active {
  background-color: #f9f9f9;
}

.row-left {
  display: flex;
  align-items: center;
}

.row-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.row-text-group {
  display: flex;
  flex-direction: column;
}

.row-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.row-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.arrow-right {
  font-size: 36rpx;
  color: #cccccc;
  line-height: 1;
}