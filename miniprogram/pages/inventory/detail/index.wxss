.detail-card {
  padding: 28rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.model-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.model-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.badge.new {
  background: #e8f4ff;
  color: #1989fa;
}

.badge.used {
  background: #fffbe6;
  color: #fa8c16;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.label {
  color: #888888;
}

.val {
  color: #333333;
}

.imei-code {
  font-family: monospace;
  font-weight: bold;
}

.val.price {
  color: #ee0a24;
  font-weight: bold;
}

.val.link {
  color: #1989fa;
}

.status-text.in_stock {
  color: #07c160;
  font-weight: bold;
}

.status-text.repair {
  color: #fa8c16;
  font-weight: bold;
}

.status-text.scrap {
  color: #ee0a24;
  font-weight: bold;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 操作按鈕 */
.action-card {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.btn {
  flex: 1;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 44rpx;
  padding: 0 !important;
}

.btn-warning {
  background: #fa8c16;
  color: #ffffff;
}

.btn-danger {
  background: #ee0a24;
  color: #ffffff;
}