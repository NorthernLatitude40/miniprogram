.header-card {
  padding: 24rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #323233;
  box-sizing: border-box;
}

.search-btn {
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 32rpx !important;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  white-space: nowrap;
}

/* 數據概覽 */
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
}

.stat-num.new-color {
  color: #1989fa;
}

.stat-num.used-color {
  color: #fa8c16;
}

.stat-label {
  font-size: 24rpx;
  color: #969799;
  margin-top: 4rpx;
}

.stat-line {
  width: 1rpx;
  height: 40rpx;
  background: #dcdee0;
}

/* Tab 切換 */
.tab-header {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #1989fa;
  color: #ffffff;
  font-weight: bold;
}

/* 庫存卡片列表 */
.inventory-list {
  display: flex;
  flex-direction: column;
}

.item-card {
  padding: 24rpx !important;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ebedf0;
  margin-bottom: 16rpx;
}

.model-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.badge.new {
  background: #e8f4ff;
  color: #1989fa;
}

.badge.used {
  background: #fffbe6;
  color: #fa8c16;
}

.card-body .row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.card-body .row:last-child {
  margin-bottom: 0;
}

.label {
  color: #969799;
}

.val {
  color: #323233;
}

.imei-code {
  font-family: monospace;
  font-weight: 500;
}

.val.price {
  color: #ee0a24;
  font-weight: bold;
}

.empty-box {
  text-align: center;
  padding: 80rpx 0;
  color: #969799;
  font-size: 28rpx;
}

/* Tab 內的佈局與排序箭頭 */
.tab-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.sort-icon {
  font-size: 22rpx;
  font-weight: normal;
  margin-left: 2rpx;
}

/* 底部入庫時間與庫齡左右兩端對齊 */
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-row {
  display: flex;
  align-items: center;
}

/* 庫齡標籤 */
.age-tag {
  color: #52c41a;
  font-weight: 500;
}

/* 庫齡超過 30 天提示積壓（紅色） */
.age-tag.warning-age {
  color: #f5222d;
  font-weight: bold;
}