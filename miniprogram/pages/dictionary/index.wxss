page {
  background-color: #f7f8fa;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 主體區域 */
.page-content {
  width: 100%;
}

/* Tabs 滾動列修復 */
.tabs-scroll {
  width: 100%;
  white-space: nowrap;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  /* 取消原先會頂到屏幕最上方 top:0 的 sticky 定位，改用普通塊級渲染或相對定位 */
  position: relative;
  z-index: 10;
}

/* 讓 scroll-view 內部的 flex 項目正確水平排列 */
.tabs-scroll ::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.tab-item {
  display: inline-block;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  vertical-align: middle;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active .tab-text {
  position: relative;
}

/* 用偽元素繪製底部藍色指示條，避免 border-bottom 影響整體高度 */
.tab-item.active .tab-text::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #007aff;
  border-radius: 2rpx;
}

/* 字典列表 */
.dict-list {
  padding: 20rpx;
}

.dict-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  padding: 28rpx 32rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.dict-info {
  display: flex;
  align-items: center;
}

.dict-label {
  font-size: 30rpx;
  color: #333333;
}

.dict-tag {
  font-size: 20rpx;
  color: #999999;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}

.delete-btn {
  font-size: 26rpx;
  color: #ff3b30;
  padding: 10rpx 0 10rpx 20rpx;
}

.empty-tip {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  margin-top: 80rpx;
}

/* 底部按鈕及安全區適配 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 90;
}

.btn-primary {
  background-color: #007aff;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 彈窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
  backdrop-filter: blur(2px); /* 輕微背景模糊，質感提升 */
}

/* 彈窗主體 */
.modal-content {
  width: 80%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx; /* 更圓潤的現代邊角 */
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.modal-header {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  background-color: #f7f8fa;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 40rpx;
  border: 1rpx solid #eef0f2;
}

/* 按鈕區域 */
.modal-footer {
  display: flex;
  justify-content: space-between;
  gap: 20rpx; /* 兩按鈕間距 */
}

/* 清除小程序原生 button 的預設邊框與樣式 */
.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx; /* 全圓角膠囊造型 */
  padding: 0;
  margin: 0;
  border: none;
}

.btn-cancel::after, .btn-confirm::after {
  border: none; /* 去除原生 ::after 邊框 */
}

/* 取消按鈕：淺灰色膠囊 */
.btn-cancel {
  background-color: #f2f3f5;
  color: #646566;
}

.btn-cancel:active {
  background-color: #e8e9eb;
}

/* 確定按鈕：品牌藍膠囊 + 輕微陰影 */
.btn-confirm {
  background-color: #007aff;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.3);
}

.btn-confirm:active {
  background-color: #0062cc;
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}