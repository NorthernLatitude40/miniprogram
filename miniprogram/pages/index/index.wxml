<view class="app-container">
  
  <!-- 1. 顶部区域 (包含动态算出的胶囊安全高度) -->
  <view class="header-section">
    <!-- 💡 动态安全区：避开顶部状态栏和右上角胶囊 -->
    <view class="safe-area-top" style="height: {{navHeight}}px;"></view>
    
    <!-- 收支概览看板 -->
    <view class="card header-card">
      <view class="card-title">收支概览 (今日)</view>
      <view class="stats-grid">
        <view class="stat-item">
          <text class="stat-label">今日毛利(元)</text>
          <text class="stat-value profit">¥ {{stats.profit}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">今日收入(元)</text>
          <text class="stat-value">¥ {{stats.income}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">今日支出(元)</text>
          <text class="stat-value">¥ {{stats.expense}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">在库设备(台)</text>
          <text class="stat-value">{{stats.stockCount}}</text>
        </view>
      </view>
    </view>

    <!-- 🤖 AI 标题横幅 -->
    <view class="ai-banner">
      <view class="ai-title">
        <text class="ai-icon">🤖</text>
        <text class="title-text">ONTO 手机店 AI 管家</text>
      </view>
      <text class="badge">自然语言开单/查账</text>
    </view>
  </view>

  <!-- 2. 中间 AI 聊天主区域 -->
  <view class="chat-container">
    <!-- 🌟 修正：补全 scroll-view 的关键属性与增强滑动性能 -->
    <scroll-view 
      class="chat-list" 
      scroll-y="true" 
      scroll-into-view="{{lastMsgId}}"
      scroll-with-animation="true"
      enhanced="true"
      bounces="true"
      show-scrollbar="true"
    >
      <block wx:for="{{messages}}" wx:key="index">
        
        <!-- 用户消息 -->
        <view id="msg-{{index}}" class="msg-item user" wx:if="{{item.role === 'user'}}">
          <view class="bubble">{{item.content}}</view>
        </view>

        <!-- 机器人回复 -->
        <view id="msg-{{index}}" class="msg-item robot" wx:if="{{item.role === 'assistant'}}">
          <view class="robot-content">
            <view class="bubble" wx:if="{{item.content}}">{{item.content}}</view>

            <!-- 解析卡片 -->
            <block wx:if="{{item.parsedData}}">
              
              <!-- 入库卡片 -->
              <view class="parsed-card card-in" wx:if="{{item.parsedData.type === 'in' || item.parsedData.action === 'in'}}">
                <view class="card-title title-in">📦 设备解析成功 (入库)</view>
                <view class="card-item">型号：{{item.parsedData.model || item.parsedData.model_or_id}}</view>
                <view class="card-item">成本：￥{{item.parsedData.cost || item.parsedData.cost_price}}</view>
                <view class="card-item" wx:if="{{item.parsedData.notes}}">备注：{{item.parsedData.notes}}</view>
                
                <!-- 🌟 增加了 disabled, class 条件判断, data-index 和动态文字 -->
                <button 
                  class="confirm-btn btn-in {{item.isConfirmed ? 'btn-disabled' : ''}}" 
                  size="mini" 
                  disabled="{{item.isConfirmed}}"
                  bindtap="confirmAdd" 
                  data-info="{{item.parsedData}}"
                  data-index="{{index}}"
                >
                  {{item.isConfirmed ? '已完成入库' : '确认入库'}}
                </button>
              </view>

              <!-- 出售卡片 -->
              <view class="parsed-card card-out" wx:elif="{{item.parsedData.type === 'out' || item.parsedData.action === 'sell'}}">
                <view class="card-title title-out">💰 设备解析成功 (出售)</view>
                <view class="card-item">型号：{{item.parsedData.model || item.parsedData.model_or_id}}</view>
                <view class="card-item">售价：￥{{item.parsedData.price || item.parsedData.sell_price}}</view>
                <view class="card-item" wx:if="{{item.parsedData.notes}}">备注：{{item.parsedData.notes}}</view>
                
                <!-- 🌟 增加了 disabled, class 条件判断, data-index 和动态文字 -->
                <button 
                  class="confirm-btn btn-out {{item.isConfirmed ? 'btn-disabled' : ''}}" 
                  size="mini" 
                  disabled="{{item.isConfirmed}}"
                  bindtap="confirmSell" 
                  data-info="{{item.parsedData}}"
                  data-index="{{index}}"
                >
                  {{item.isConfirmed ? '已完成出库' : '确认出售/出库'}}
                </button>
              </view>

              <!-- 报表卡片 -->
              <view class="parsed-card card-report" wx:elif="{{item.parsedData.action === 'query_report'}}">
                <view class="card-title title-report">
                  <text>📊 {{item.parsedData.time_range_text || '经营'}}报表概览</text>
                </view>
                <view class="report-grid">
                  <view class="report-item highlight">
                    <text class="report-label">销售毛利</text>
                    <text class="report-val profit">￥{{item.parsedData.report.profit || 0}}</text>
                  </view>
                  <view class="report-item">
                    <text class="report-label">出售台数</text>
                    <text class="report-val">{{item.parsedData.report.sales_count || 0}} 台</text>
                  </view>
                  <view class="report-item">
                    <text class="report-label">营业收入</text>
                    <text class="report-val">￥{{item.parsedData.report.income || 0}}</text>
                  </view>
                  <view class="report-item">
                    <text class="report-label">进货支出</text>
                    <text class="report-val">￥{{item.parsedData.report.expense || 0}}</text>
                  </view>
                </view>
              </view>

              <!-- 库存卡片 -->
              <view class="parsed-card card-stock" wx:elif="{{item.parsedData.action === 'query_stock'}}">
                <view class="card-title title-stock">
                  <text>🔍 库存查询结果</text>
                  <text class="stock-badge">共 {{item.parsedData.total_count || 0}} 台</text>
                </view>

                <view class="empty-tip" wx:if="{{!item.parsedData.items || item.parsedData.items.length === 0}}">
                  未找到与“{{item.parsedData.keyword}}”相关的在库设备
                </view>

                <view class="stock-list" wx:else>
                  <block wx:for="{{item.parsedData.items}}" wx:key="id" wx:for-item="stock">
                    <view class="stock-item">
                      <view class="stock-main">
                        <text class="stock-title">{{stock.model}}</text>
                        <view class="stock-tags">
                          <text class="tag spec-tag">{{stock.spec || '标准'}}</text>
                          <text class="tag id-tag">ID: {{stock.id}}</text>
                        </view>
                      </view>
                      <view class="stock-price-info">
                        <text class="stock-cost">成本 ￥{{stock.cost}}</text>
                        <text class="stock-qty" wx:if="{{stock.stock_quantity > 1}}">库存: {{stock.stock_quantity}}台</text>
                      </view>
                    </view>
                  </block>
                </view>
              </view>

            </block>
          </view>
        </view>

      </block>
      
      <!-- 🌟 底部垫高块：确保最后一条消息/卡片完全露出，不被输入框挡住 -->
      <view style="height: 30rpx; width: 100%;"></view>
    </scroll-view>

    <!-- 3. 底部输入与常用业务控制栏 -->
    <view class="chat-footer">
      <view class="chat-input-row">
        <!-- 👈 常用业务控制按钮 -->
        <view class="menu-toggle-btn {{showMenu ? 'active' : ''}}" bindtap="toggleMenu">
          <text class="toggle-icon">🛠️</text>
          <text class="toggle-text">业务</text>
        </view>

        <!-- 输入框 -->
        <input class="input" value="{{inputMsg}}" bindinput="onInput" placeholder="输入开单/估价/查账指令..." confirm-type="send" bindconfirm="sendToAgent" />
        
        <!-- 发送按钮 -->
        <button class="send-btn" type="primary" size="mini" bindtap="sendToAgent">发送</button>
      </view>

      <!-- 点击后弹出的常用业务抽屉菜单 -->
      <view class="menu-drawer" wx:if="{{showMenu}}">
        <view class="menu-grid">
          <view class="menu-item">
            <text class="menu-icon">📱</text>
            <text class="menu-text">二手库存</text>
          </view>
          <view class="menu-item">
            <text class="menu-icon">📦</text>
            <text class="menu-text">新机出入库</text>
          </view>
          <view class="menu-item">
            <text class="menu-icon">🔧</text>
            <text class="menu-text">维修开单</text>
          </view>
          <view class="menu-item">
            <text class="menu-icon">🛠️</text>
            <text class="menu-text">配件库存</text>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>