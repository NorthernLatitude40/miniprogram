<view class="app-container">
  
  <!-- 1. 自訂導航欄組件 -->
  <nav-bar title="{{shopName}}" showBack="{{false}}"></nav-bar>

  <!-- 2. 頂部區域 -->
  <view class="header-section">

    <!-- 切換至核心業務版入口按鈕 -->
    <view class="layout-switch-btn" bindtap="goToBusinessPage">
      <text>📊 {{t.switch_to_business_ver || '切換至核心業務版'}} ❯</text>
    </view>
  
    <!-- 🌟 2. 抽離後的收支概覽看板組件 -->
    <header-card 
      userRole="{{userRole}}" 
      stats="{{stats}}" 
      t="{{t}}" 
    />

    <!-- AI 標題橫幅 -->
    <view class="ai-banner">
      <view class="ai-title">
        <text class="ai-icon">🤖</text>
        <text class="title-text">{{t.ai_housekeeper_title || 'ONTO 手機店 AI 管家'}}</text>
      </view>
      <text class="badge">{{t.ai_housekeeper_badge || '自然語言開單/查帳'}}</text>
    </view>
    
  </view>

  <!-- 3. 聊天主體組件（包含列表與底部輸入） -->
  <chat-box 
      messages="{{messages}}"
      lastMsgId="{{lastMsgId}}"
      stockList="{{stockList}}"
      loading="{{isLoading}}"
      userRole="{{userRole}}"
      stats="{{stats}}"
      bind:sendMessage="onSendMessage"
      bind:confirmAdd="confirmAdd"
      bind:confirmSell="confirmSell"
      bind:selectStockDevice="onSelectStockDevice"
    />

</view>