page {
  background-color: #f4f5f7;
  padding: 20rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  display: block;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #111;
}

.stat-value.profit {
  color: #07c160;
}

/* AI 专区样式 */
.ai-card {
  background: linear-gradient(135deg, #2b58f0 0%, #1032a5 100%);
  color: #ffffff;
}

.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ai-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.ai-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.badge {
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.ai-tip {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}

/* 聊天框 */
.chat-container {
  height: 600rpx;
  display: flex;
  flex-direction: column;
}

.chat-list {
  flex: 1;
  overflow-y: auto;
  padding: 10rpx;
}

.msg-item {
  display: flex;
  margin-bottom: 20rpx;
}

.msg-item.user {
  flex-direction: row-reverse;
}

.avatar {
  font-size: 40rpx;
  margin: 0 10rpx;
}

.bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f0f0f0;
}

.msg-item.user .bubble {
  background: #95ec69;
}

.chat-input-area {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.send-btn {
  margin-left: 10rpx;
}

/* 功能菜单网格 */
.menu-grid {
  display: flex;
  justify-content: space-around;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.menu-icon {
  font-size: 50rpx;
  margin-bottom: 8rpx;
}

.parsed-card {
  background: #fff;
  border: 1rpx solid #eee;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #333;
}

.card-tag {
  color: #2b58f0;
  font-weight: bold;
}

.confirm-btn {
  margin-top: 10rpx;
  background-color: #07c160;
  color: white;
}