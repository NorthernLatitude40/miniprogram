page {
  background-color: #f4f5f7;
  height: 100vh;
  overflow: hidden;
}

/* 整体 Flex 容器 */
.app-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部卡片区域 */
.header-section {
  flex-shrink: 0;
  padding: 0 20rpx;
}

/* 动态获取的顶部胶囊安全区 */
.safe-area-top {
  width: 100%;
  flex-shrink: 0;
}

/* 看板卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 50%;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #888;
  display: block;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #111;
}

.stat-value.profit {
  color: #07c160;
}

/* AI 标题横幅 */
.ai-banner {
  background: linear-gradient(135deg, #2b58f0 0%, #1032a5 100%);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ai-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
}

.ai-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.badge {
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

/* 中间聊天主容器：自动延伸伸缩 flex: 1 */
.chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  margin: 0 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  height: 0; /* 🌟 核心防撑开关键点 */
}

/* 🌟 核心修正：加 flex: 1; height: 0; 才能在 Flex 布局下正常响应滑动 */
.chat-list {
  flex: 1;
  height: 0;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 气泡消息与内容排版 */
.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  width: 100%;
}

.msg-item.user {
  justify-content: flex-end;
}

.msg-item.user .bubble {
  background: #95ec69;
  color: #000000;
  border-top-right-radius: 4rpx;
}

.msg-item.robot {
  justify-content: flex-start;
}

.robot-content {
  max-width: 85%;
}

.msg-item.robot .bubble {
  background: #f0f0f0;
  color: #333333;
  border-top-left-radius: 4rpx;
}

.bubble {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

/* 各种业务返回卡片 */
.parsed-card {
  background: #ffffff;
  border: 1rpx solid #e5e5e5;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.parsed-card .card-title {
  font-weight: bold;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.parsed-card .card-item {
  margin-bottom: 6rpx;
}

.confirm-btn {
  margin-top: 16rpx !important;
  width: 100% !important;
}

.parsed-card.card-in { border: 1rpx solid #d9d9d9; }
.card-title.title-in { color: #2b58f0; }
.confirm-btn.btn-in { background-color: #07c160 !important; color: #fff !important; }

.parsed-card.card-out { border: 1rpx solid #ffe0b2; background-color: #fffbe6; }
.card-title.title-out { color: #fa8c16; }
.confirm-btn.btn-out { background-color: #ff9800 !important; color: #fff !important; }

.parsed-card.card-report { border: 1rpx solid #e2e8f0; border-left: 8rpx solid #10b981; }
.title-report { color: #065f46 !important; border-bottom: 1rpx solid #f1f5f9; padding-bottom: 8rpx; margin-bottom: 12rpx !important; }
.report-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.report-item { background-color: #f8fafc; border-radius: 8rpx; padding: 10rpx; display: flex; flex-direction: column; }
.report-item.highlight { background-color: #ecfdf5; }
.report-label { font-size: 20rpx; color: #64748b; }
.report-val { font-size: 26rpx; font-weight: bold; color: #1e293b; margin-top: 4rpx; }
.report-val.profit { color: #10b981; }

.parsed-card.card-stock { border: 1rpx solid #e2e8f0; border-left: 8rpx solid #3b82f6; }
.title-stock { color: #1e293b !important; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #f1f5f9; padding-bottom: 8rpx; margin-bottom: 12rpx !important; }
.stock-badge { font-size: 20rpx; background-color: #eff6ff; color: #2563eb; padding: 2rpx 10rpx; border-radius: 20rpx; }
.stock-item { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-bottom: 1rpx dashed #f1f5f9; }
.stock-main { display: flex; flex-direction: column; gap: 4rpx; }
.stock-title { font-size: 26rpx; font-weight: 600; color: #334155; }
.stock-tags { display: flex; gap: 8rpx; }
.tag { font-size: 18rpx; padding: 2rpx 6rpx; border-radius: 4rpx; }
.spec-tag { background-color: #f8fafc; color: #64748b; border: 1rpx solid #e2e8f0; }
.id-tag { background-color: #f1f5f9; color: #94a3b8; }
.stock-price-info { display: flex; flex-direction: column; align-items: flex-end; }
.stock-cost { font-size: 24rpx; font-weight: bold; color: #059669; }
.stock-qty { font-size: 18rpx; color: #94a3b8; }
.empty-tip { font-size: 24rpx; color: #94a3b8; text-align: center; padding: 16rpx 0; }

/* 底部固定操作栏 */
.chat-footer {
  flex-shrink: 0; /* 🌟 确保底部不会被挤压 */
  background: #fafafa;
  border-top: 1rpx solid #eaeaea;
  padding: 16rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
}

.chat-input-row {
  display: flex;
  align-items: center;
}

/* 常用业务左侧切换按键 */
.menu-toggle-btn {
  display: flex;
  align-items: center;
  background: #f0f2f5;
  border: 1rpx solid #ddd;
  padding: 10rpx 16rpx;
  border-radius: 30rpx;
  margin-right: 12rpx;
  transition: all 0.2s ease;
}

.menu-toggle-btn.active {
  background: #2b58f0;
  border-color: #2b58f0;
}

.menu-toggle-btn.active .toggle-text {
  color: #ffffff;
}

.toggle-icon {
  font-size: 26rpx;
  margin-right: 4rpx;
}

.toggle-text {
  font-size: 22rpx;
  color: #555;
  font-weight: 500;
}

.input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 28rpx;
  background: #ffffff;
}

.send-btn {
  margin-left: 12rpx !important;
}

/* 常用业务展开面板 */
.menu-drawer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e5e5;
  animation: slideUp 0.2s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.menu-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.menu-text {
  font-size: 22rpx;
  color: #444;
}

/* 🌟 禁用/已完成状态下的样式 */
.confirm-btn.btn-disabled,
button[disabled].confirm-btn {
  background-color: #cccccc !important;
  color: #ffffff !important;
  border-color: #cccccc !important;
  opacity: 0.6;
}

/* 万能卡片边框与标题样式 */
.card-universal {
  border-left: 8rpx solid #07c160; /* 采用绿色系或蓝紫色系 */
}

.title-universal {
  color: #07c160;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: bold;
  margin-bottom: 12rpx;
}


/* ==================== 🌟 店员视角：超可爱卡通 Banner ==================== */
.no-perm-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #f5f3ff 100%);
  padding: 16rpx 10rpx;
  border-radius: 20rpx;
}

.banner-avatar {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  /* 增加微小浮动动画效果，让卡通小机器人活起来 */
  animation: float 3s ease-in-out infinite;
}

.banner-content {
  flex: 1;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a8a;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.4;
}

/* 卡通头像轻微悬浮动画 */
@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-6rpx); }
  100% { transform: translateY(0px); }
}

/* 角色小标签 */
.role-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.role-badge.admin {
  background: #eff6ff;
  color: #2563eb;
}
.role-badge.manager {
  background: #f0fdf4;
  color: #16a34a;
}
.role-badge.staff {
  background: #f3f4f6;
  color: #6b7280;
}
.card-header-bar {
  display: flex;
  justify-content: space-between; /* 左右两端对齐：标题靠左，标签靠右 */
  align-items: center;            /* 垂直居中对齐 */
  margin-bottom: 20rpx;           /* 保持与下方内容的间距 */
}