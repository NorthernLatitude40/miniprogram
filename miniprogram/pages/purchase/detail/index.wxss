.detail-card {
  padding: 28rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.status-banner {
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-weight: bold;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.status-banner.pending {
  background: #fffbe6;
  color: #fa8c16;
}

.status-banner.completed {
  background: #e6f7ff;
  color: #1890ff;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.label {
  color: #888888;
}

.val {
  color: #333333;
}

.val.price {
  color: #ee0a24;
  font-weight: bold;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.model-block {
  margin-bottom: 20rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.imei-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.imei-chip {
  background: #f5f5f5;
  color: #666666;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-family: monospace;
}

.confirm-btn {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  margin-top: 40rpx !important;
  margin-bottom: 60rpx !important;
}