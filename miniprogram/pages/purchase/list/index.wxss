/* 頂部搜尋與按鈕區域專屬樣式 */
.header-card {
  padding: 24rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #323233;
  box-sizing: border-box;
}

.search-btn {
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 32rpx !important;
  background: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  white-space: nowrap;
}

/* 橫向排列按鈕容器 */
.action-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 !important;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  text-align: center;
}

.btn-primary {
  background: #1989fa;
  color: #ffffff;
}

.btn-secondary {
  background: #e8f4ff;
  color: #1989fa;
}

/* 狀態 Tab 切換列 */
.tab-header {
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #646566;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #1989fa;
  color: #ffffff;
  font-weight: bold;
}

/* 單據卡片列表 */
.order-list {
  display: flex;
  flex-direction: column;
}

.order-card {
  padding: 24rpx !important;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #ebedf0;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #323233;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.badge.new {
  background: #e8f4ff;
  color: #1989fa;
}

.badge.used {
  background: #fffbe6;
  color: #fa8c16;
}

.card-body .row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.label {
  color: #969799;
}

.val {
  color: #323233;
}

.val.price {
  color: #ee0a24;
  font-weight: bold;
  font-size: 30rpx;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #ebedf0;
}

.time {
  font-size: 24rpx;
  color: #c8c9cc;
}

.status-tag {
  font-size: 24rpx;
  font-weight: 500;
}

.status-tag.pending {
  color: #fa8c16;
}

.status-tag.completed {
  color: #07c160;
}

.empty-box {
  text-align: center;
  padding: 80rpx 0;
  color: #969799;
  font-size: 28rpx;
}