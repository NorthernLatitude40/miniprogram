.detail-card {
  padding: 28rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.status-banner {
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-weight: bold;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.status-banner.completed {
  background: #e6f7ff;
  color: #1890ff;
}

.status-banner.returned {
  background: #fff2f0;
  color: #ff4d4f;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.label {
  color: #888888;
}

.val {
  color: #333333;
}

.val.price {
  color: #ee0a24;
  font-weight: bold;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.device-item:last-child {
  border-bottom: none;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.imei-code {
  font-size: 24rpx;
  color: #888888;
  font-family: monospace;
}

.price-text {
  font-size: 28rpx;
  color: #ee0a24;
  font-weight: bold;
}

.return-btn {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  margin-top: 40rpx !important;
  margin-bottom: 60rpx !important;
}