.form-card {
  padding: 28rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.scan-btn {
  height: 56rpx !important;
  line-height: 56rpx !important;
  padding: 0 24rpx !important;
  background: #07c160;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 28rpx;
  margin: 0 !important;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.border-none {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666666;
  width: 200rpx;
}

.val {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

.price-input {
  color: #ee0a24;
  font-size: 34rpx;
  font-weight: bold;
}

/* 設備列表樣式 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.imei-code {
  font-size: 24rpx;
  color: #888888;
  font-family: monospace;
}

.device-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input-sm {
  width: 140rpx;
  height: 56rpx;
  background: #ffffff;
  border: 1rpx solid #dcdee0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ee0a24;
  font-weight: bold;
}

.btn-del {
  font-size: 24rpx;
  color: #ee0a24;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #cccccc;
  font-size: 26rpx;
}

/* 底部提交按鈕 */
.submit-btn {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  background: #1989fa;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  margin-top: 40rpx !important;
  margin-bottom: 60rpx !important;
}

.manual-input-box {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.manual-input {
  flex: 1;
  background-color: #f7f8fa;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 130rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  padding: 0;
  border-radius: 8rpx;
  margin: 0 !important;
}