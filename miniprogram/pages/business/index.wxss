/* pages/business/index.wxss */

page {
  background-color: #f5f6fa;
  box-sizing: border-box;
}

.business-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 24rpx 24rpx 24rpx; /* 页面内容内边距，避开顶部 fixed 导航栏 */
  box-sizing: border-box;
}

/* ==================== 1. 固定顶部自定义导航栏 ==================== */
.custom-nav-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #f5f6fa;
  z-index: 9999;
  box-sizing: border-box;
}

.nav-title-bar {
  display: flex;
  align-items: center;      /* 垂直居中对齐胶囊 */
  justify-content: center;   /* 水平居中对齐标题 */
  width: 100%;
  margin: 0;
  padding: 0;
}

.nav-shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ==================== 2. 返回 AI 对话引导卡片 ==================== */
.ai-entry-card {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.25);
}

.ai-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-avatar {
  font-size: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-text-group {
  display: flex;
  flex-direction: column;
}

.ai-title {
  font-size: 28rpx;
  font-weight: bold;
}

.ai-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.arrow-right {
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
}

/* ==================== 3. 经营收支报表看板卡片 ==================== */
.report-dashboard-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
}

/* 时间筛选下拉按钮 */
.time-select-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f3f4f6;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #374151;
  font-weight: 500;
}

.arrow-down {
  font-size: 16rpx;
  color: #9ca3af;
}

/* 4 大核心指标网格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;  /* 改成靠左，不再居中 */
  padding: 0 8rpx;
  box-sizing: border-box;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #111827;
}

.stat-value.profit {
  color: #ef4444; /* 今日毛利高亮 */
}

.stat-value.month-profit {
  color: #7c3aed; /* 本月毛利高亮 */
}

.chart-sub-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5563;
}

.chart-unit {
  font-size: 20rpx;
  color: #9ca3af;
}

.chart-placeholder {
  height: 160rpx;
  background-color: #f9fafb;
  border-radius: 12rpx;
  border: 1rpx dashed #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-tips {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ==================== 4. 核心功能板块 (5/6 宫格) ==================== */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1f2937;
  margin-top: 8rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.grid-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.1s ease;
}

.grid-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.card-icon {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标背景主题色 */
.purchase .card-icon { background-color: #ecfdf5; }
.sales .card-icon { background-color: #fff7ed; }
.stock-new .card-icon { background-color: #eff6ff; }
.stock-used .card-icon { background-color: #f5f3ff; }
.profile .card-icon { background-color: #f3f4f6; }

.card-info {
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
}

.card-desc {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

/* ==================== 搜索框区域 ==================== */
.search-section {
  width: 100%;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #e5e7eb;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #1f2937;
}

.scan-icon {
  font-size: 32rpx;
  padding: 0 8rpx;
  color: #4b5563;
}

/* 趋势图表卡片样式 */
.chart-container {
  margin-top: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx 10rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.chart-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.chart-sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.chart-unit {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 必须设置固定的宽高或响应式宽高 */
.chart-wrapper {
  width: 100%;
  height: 400rpx;
  position: relative;
}

ec-canvas {
  width: 100%;
  height: 100%;
}