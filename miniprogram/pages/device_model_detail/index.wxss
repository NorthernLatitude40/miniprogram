/* pages/device_model_detail/device_model_detail.wxss */
page {
  background-color: #f7f8fa;
  color: #333333;
  padding-bottom: 140rpx;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #646566;
  padding: 14rpx 0;
  border-radius: 32rpx;
}

.tab-item.active {
  background-color: #007aff;
  color: #ffffff;
  font-weight: 600;
}

.content-body {
  padding: 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8c8c8c;
  margin-bottom: 24rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-chip {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border: 1rpx solid #e1e3e6;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.02);
}

.chip-label {
  font-size: 28rpx;
  color: #1a1a1a;
  margin-right: 12rpx;
}

.chip-delete {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx;
}

.empty-tip {
  text-align: center;
  color: #969799;
  font-size: 28rpx;
  margin-top: 100rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-add {
  background-color: #007aff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.modal-content {
  width: 80%;
  background-color: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
}

.modal-header {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  background-color: #f7f8fa;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.btn-cancel { background-color: #f2f3f5; color: #646566; }
.btn-confirm { background-color: #007aff; color: #ffffff; }