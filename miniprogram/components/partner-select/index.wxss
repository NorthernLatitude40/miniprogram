/* 全局頁面背景（淺灰襯托白色卡片） */
page {
  background-color: #f5f6f8;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 1. 卡片主體容器 */
.section-card {
  background-color: #ffffff; /* 白色背景 */
  border-radius: 20rpx;      /* 圓角 */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03); /* 輕微陰影層次 */
  overflow: hidden;
}

.form-card {
  padding: 28rpx !important;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
}

/* 2. 卡片標題 */
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 3. 表單行與 Cell 樣式 */
.form-item,
.cell-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  min-height: 88rpx;
  box-sizing: border-box;
}

/* 邊框隔線 */
.border-bottom {
  border-bottom: 1rpx solid #f7f8fa;
}

.form-item:last-child {
  border-bottom: none; /* 最後一行去除下劃線 */
}

/* 4. 文字與輸入框 */
.label,
.cell-label {
  font-size: 28rpx;
  color: #333333;
  width: 200rpx;
  flex-shrink: 0;
}

.required {
  color: #ff4d4f;
  margin-left: 4rpx;
}

.input,
.cell-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  height: 60rpx;
}

.cell-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.text-dark {
  color: #333333;
}

.text-placeholder {
  color: #bbbbbb;
}

.arrow {
  color: #cccccc;
  margin-left: 10rpx;
  font-size: 26rpx;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}