.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f7f8fa;
}

.label {
  font-size: 28rpx;
  color: #666666;
  width: 200rpx;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

.form-card {
  padding: 28rpx !important;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}