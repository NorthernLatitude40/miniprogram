/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

/* 全局通欄主按鈕樣式 */
.btn-primary {
  width: 100% !important;     /* 🌟 強制覆蓋小程式預設的 184px 寬度 */
  box-sizing: border-box;     /* 確保 padding 不會撐大按鈕 */
  background-color: #2f74ff;  /* 統一主題藍 */
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;        /* 統一 16rpx 微圓角 */
  text-align: center;
  border: none;
  padding: 0;                 /* 清除預設內邊距 */
}

.btn-primary:active {
  opacity: 0.88;
}

/* app.wxss */
page {
  background-color: #f5f6fa;
  box-sizing: border-box;
}

/* 頁面通用外層容器 */
.page-container {
  width: 100%;
  padding: 0 32rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 通用白色圓角卡片容器 */
.section-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
}

/* 列表選單行 */
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  position: relative;
  transition: background-color 0.2s ease;
}

/* 卡片內多個選單項之間的底部分割線 */
.menu-row:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  left: 60rpx;
  height: 1rpx;
  background-color: #f0f0f0;
}

.menu-row:active {
  background-color: #f9f9f9;
}

.row-left {
  display: flex;
  align-items: center;
}

.row-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.row-text-group {
  display: flex;
  flex-direction: column;
}

.row-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.row-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.arrow-right {
  font-size: 36rpx;
  color: #cccccc;
  line-height: 1;
}

/* 全局清除 button 預設彈性寬度 */
button {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
button::after {
  border: none;
}